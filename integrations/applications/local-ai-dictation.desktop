[Desktop Entry]
Version=1.0
Type=Application
Name=Local AI Dictation
GenericName=Speech-to-text dictation
Comment=Control Whisper, Parakeet, and Willow Voice dictation
Exec=local-ai-dictation gui
TryExec=local-ai-dictation
Icon=audio-input-microphone
